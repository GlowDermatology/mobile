// The iOS OAuth client id reversed (Google Cloud → Credentials → the iOS client → "iOS URL
// scheme"), e.g. com.googleusercontent.apps.1234567890-abcdefg.
GOOGLE_REVERSED_CLIENT_ID =

#include? "Social.local.xcconfig"
